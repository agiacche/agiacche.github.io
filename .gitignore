# Ignore the contents of the _site directory and other cache directories
_site/
_site_test/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Bundler
.bundle/
vendor/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json

# macOS Finder metadata
.DS_Store

# Scratch output some AI coding tools drop at the repo root - never meant
# to be committed (e.g. a one-off generated PDF used to sanity-check a
# change before it's copied to files/)
Claude outputs/
